# Discord application
DISCORD_TOKEN=replace_with_bot_token
DISCORD_CLIENT_ID=replace_with_application_client_id
DISCORD_CLIENT_SECRET=replace_with_oauth2_client_secret
DISCORD_GUILD_ID=replace_with_test_server_id
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# Runtime
NODE_ENV=development
BOT_SHARDS=auto
DASHBOARD_PORT=3000

# Data
DATABASE_URL=postgresql://doggo:doggo@localhost:5432/doggo
REDIS_URL=redis://localhost:6379

# Optional providers
LLM_PROVIDER=disabled
LLM_API_KEY=
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=doggo
S3_ACCESS_KEY=minio
S3_SECRET_KEY=miniosecret

# Bot commands
BOT_COMMANDS=applications.commands
